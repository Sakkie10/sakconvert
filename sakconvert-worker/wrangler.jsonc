{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sakconvert-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-05-27",
  "account_id": "bfbc2cde2b8157e942b9b77c69dc4ac9",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "www.sakconvert.com/api/subscribe*",
      "zone_name": "sakconvert.com"
    },
    {
      "pattern": "sakconvert.com/api/subscribe*",
      "zone_name": "sakconvert.com"
    }
  ],

  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sakconvert_subscribers",
      "database_id": "ce71fc80-5c8b-47fd-bf70-9a28e652061a"
    }
  ]
}